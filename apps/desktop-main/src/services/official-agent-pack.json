        },
        "lifecycle": {
          "id": "aider",
          "version": "2026.08.12.1",
          "sourceRevision": "aider-main-20260812",
          "authority": "none",
          "aliases": [],
          "rules": [
            {
              "id": "confirmation_prompt",
              "state": "blocked",
              "priority": 300,
              "region": { "kind": "whole_recent" },
              "visibleBlocker": true,
              "contains": ["(Y)es/(N)o"]
            },
            {
              "id": "waiting_for_model",
              "state": "working",
              "priority": 120,
              "region": { "kind": "bottom_non_empty_lines", "count": 6 },
              "visibleWorking": true,
              "lineRegex": ["^\\s*Waiting for .+"]
            },
            {
              "id": "composer_prompt",
              "state": "idle",
              "priority": 100,
              "region": { "kind": "bottom_non_empty_lines", "count": 4 },
              "visibleIdle": true,
              "lineRegex": ["^\\s*(?:\\S+(?:\\s+multi)?|multi)?\\s*>\\s*$"]
            }
          ]
        }
      }
