[
  {
    "schemaVersion": 1,
    "adapterVersion": "2026.08.12.1",
    "engine": { "min": 1, "max": 1 },
    "id": "claude",
    "displayName": "Claude Code",
    "shortName": "Claude",
    "description": "Anthropic's native coding Agent CLI",
    "mark": "claude",
    "accent": "#e0876a",
    "discovery": {
      "commands": ["claude"],
      "knownPaths": ["{home}/.local/bin/claude", "{home}/.claude/bin/claude"],
      "versionArgs": ["--version"]
    },
    "terminal": {
      "promptDelivery": "deferred",
      "newSessionArgs": ["--session-id", "{sessionId}"],
      "startup": {
        "gateMarkers": [
          "Do you trust the files in this folder?",
          "Do you trust this folder?",
          "Yes, I trust this folder"
        ],
        "readyMarkers": ["Welcome back!", "Tips for getting started"],
        "readyRequired": false,
        "requireBracketedPaste": true,
        "deferInitialProbe": false,
        "updateGate": null
      },
      "exitSequence": ["interrupt", "interrupt"]
    },
    "acp": {
      "kind": "bundled",
      "package": "claude-agent-acp"
    },
    "sessions": {
      "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "preassignId": true,
      "defaultHome": "{home}/.claude",
      "resumeArgs": ["--resume", "{sessionId}"],
      "continueArgs": ["--continue"],
      "historyConnector": "claude",
      "identityConnector": "claude"
    },
    "surfaces": {
      "skillRoots": ["{home}/.claude/skills"],
      "instructionRoots": ["{home}/.claude/CLAUDE.md"],
      "remote": true
    },
    "capabilities": {
      "terminal": true,
      "acp": true,
      "loadSession": true,
      "sessionList": true,
      "sessionResume": true,
      "images": true,
      "embeddedContext": true,
      "mcp": true,
      "exactResume": true,
      "history": true,
      "skills": true,
      "instructions": true,
      "remote": true,
      "lifecycle": "observed"
    }
  },
  {
    "schemaVersion": 1,
    "adapterVersion": "2026.08.12.1",
    "engine": { "min": 1, "max": 1 },
    "id": "codex",
    "displayName": "Codex",
    "shortName": "Codex",
    "description": "OpenAI's native coding Agent CLI",
    "mark": "codex",
    "accent": "#46b477",
    "discovery": {
      "commands": ["codex"],
      "knownPaths": ["{home}/.local/bin/codex", "{home}/.codex/bin/codex"],
      "versionArgs": ["--version"]
    },
    "terminal": {
      "promptDelivery": "deferred",
      "startup": {
        "gateMarkers": ["Do you trust the contents of this directory", "Press Enter to continue"],
        "readyMarkers": ["OpenAI Codex", "/model to change"],
        "readyRequired": true,
        "requireBracketedPaste": false,
        "deferInitialProbe": true,
        "updateGate": {
          "markers": ["Update available!", "Update now", "Skip until next version"],
          "actions": ["down", "enter"]
        }
      },
      "exitSequence": ["interrupt", "eof"]
    },
    "acp": {
      "kind": "bundled",
      "package": "codex-acp"
    },
    "sessions": {
      "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "preassignId": false,
      "defaultHome": "{home}/.codex",
      "resumeArgs": ["resume", "{sessionId}"],
      "historyConnector": "codex",
      "identityConnector": "codex"
    },
    "surfaces": {
      "skillRoots": ["{home}/.codex/skills"],
      "instructionRoots": ["{home}/.codex/AGENTS.md"],
      "remote": true
    },
    "capabilities": {
      "terminal": true,
      "acp": true,
      "loadSession": true,
      "sessionList": true,
      "sessionResume": true,
      "images": true,
      "embeddedContext": true,
      "mcp": true,
      "exactResume": true,
      "history": true,
      "skills": true,
      "instructions": true,
      "remote": true,
      "lifecycle": "observed"
    }
  },
  {
    "schemaVersion": 1,
    "adapterVersion": "2026.08.12.1",
    "engine": { "min": 1, "max": 1 },
    "id": "kimi",
    "displayName": "Kimi Code",
    "shortName": "Kimi",
    "description": "Moonshot AI's native coding Agent CLI",
    "mark": "kimi",
    "accent": "#5b7cfa",
    "discovery": {
      "commands": ["kimi"],
      "knownPaths": ["{home}/.kimi-code/bin/kimi"],
      "versionArgs": ["--version"]
    },
    "terminal": {
      "promptDelivery": "deferred",
      "startup": {
        "gateMarkers": ["Trust this folder?", "Enable project MCP servers", "Don't trust"],
        "readyMarkers": [
          "Welcome to Kimi Code!",
          "No session yet — one will be created on your first message.",
          "Send /help for help information."
        ],
        "readyRequired": true,
        "requireBracketedPaste": true,
        "deferInitialProbe": false,
        "updateGate": null
      },
      "exitSequence": ["interrupt", "interrupt", "interrupt"]
    },
    "acp": {
      "kind": "native",
      "args": ["acp"]
    },
    "sessions": {
      "idPattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "preassignId": false,
      "resumeArgs": ["--session", "{sessionId}"],
      "continueArgs": ["--continue"],
      "homeEnv": "KIMI_CODE_HOME",
      "defaultHome": "{home}/.kimi-code",
      "historyConnector": "kimi",
      "identityConnector": "kimi"
    },
    "surfaces": {
      "skillRoots": ["{dataHome}/skills", "{home}/.agents/skills"],
      "instructionRoots": ["{dataHome}/AGENTS.md", "{home}/.agents/AGENTS.md"],
      "remote": true
    },
    "capabilities": {
      "terminal": true,
      "acp": true,
      "loadSession": true,
      "sessionList": true,
      "sessionResume": true,
      "images": true,
      "embeddedContext": true,
      "mcp": true,
      "exactResume": true,
      "history": true,
      "skills": true,
      "instructions": true,
      "remote": true,
      "lifecycle": "observed"
    }
  }
]
